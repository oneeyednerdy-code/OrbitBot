{
  "name": "nerdspace-orbitbot",
  "version": "0.1.0-alpha.59",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check": "npm run typecheck && npm test && npm run check:browser"
  },
  "devDependencies": {
    "wrangler": "^4.33.1",
    "typescript": "^5.9.2",
    "@cloudflare/workers-types": "^5.20260823.1"
  }
}
