{
	"name": "orbitbot",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-25",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/oauth/*",
			"/connections/*",
			"/interactions",
			"/verify/*",
			"/logout"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nerdspace-orbitbot",
			"database_id": "d8026aeb-f816-4e63-98ce-a4d591d728c8",
			"migrations_dir": "migrations"
		}
	],
	"secrets": {
		"required": [
			"DISCORD_CLIENT_ID",
			"DISCORD_CLIENT_SECRET",
			"DISCORD_BOT_TOKEN",
			"DISCORD_PUBLIC_KEY",
			"SESSION_SECRET",
			"TURNSTILE_SECRET_KEY"
		]
	},
	"vars": {
		"APP_ORIGIN": "https://orbitbot.oneeyednerdy.workers.dev",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAEdM8FKnSCsoDd_s",
		"TURNSTILE_HOSTNAMES": "orbitbot.oneeyednerdy.workers.dev",
		"ORBIT_OPERATOR_USER_IDS": ""
		// Optional integrations are configured as secrets: TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET, YOUTUBE_API_KEY, YOUTUBE_CLIENT_ID, YOUTUBE_CLIENT_SECRET, THREADS_CLIENT_ID, THREADS_CLIENT_SECRET, TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET, INSTAGRAM_CLIENT_ID, INSTAGRAM_CLIENT_SECRET, SOCIAL_CREDENTIAL_KEY
	},
	// R2 storage for direct Short-Form Video file uploads. URL-only video posts do not require it.
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "4199f63465b843deb1d7d6327c9f9beb",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "orbit_storage",
			"bucket_name": "orbit-storage",
			"remote": true
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "JOBS",
				"queue": "orbit-jobs"
			}
		],
		"consumers": [
			{
				"queue": "orbit-jobs"
			}
		]
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "GATEWAY",
				"class_name": "DiscordGateway"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DiscordGateway"
			]
		}
	],
	"preview_urls": false
}